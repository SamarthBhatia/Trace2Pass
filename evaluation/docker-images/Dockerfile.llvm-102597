# Dockerfile for LLVM with bug #102597
# Bug: Incorrect 128-bit integer handling in computeConstantDifference
# Introduced: commit 79af689
# Fixed: commit 3512bcc
# Target: Build at commit just before 3512bcc

FROM ubuntu:22.04 AS builder

# Prevent interactive prompts
ENV DEBIAN_FRONTEND=noninteractive

# Install build dependencies
RUN apt-get update && apt-get install -y \
    git \
    cmake \
    ninja-build \
    build-essential \
    python3 \
    python3-pip \
    libz-dev \
    libzstd-dev \
    libxml2-dev \
    && rm -rf /var/lib/apt/lists/*

# Clone LLVM project at specific commit (parent of fix 3512bcc)
# Buggy commit: 513c3726ebc0a324f7e5a11d25617bb9557324d6 (Aug 12, 2024)
# This commit has the bug, next commit 3512bcc fixes it
RUN git clone https://github.com/llvm/llvm-project.git /llvm-project && \
    cd /llvm-project && \
    git checkout 513c3726ebc0a324f7e5a11d25617bb9557324d6 && \
    git log -1 --oneline && \
    echo "LLVM commit with bug #102597: 513c372"

# Create build directory
WORKDIR /llvm-project/build

# Configure LLVM build (clang + compiler-rt only, minimal config)
RUN cmake -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DLLVM_ENABLE_PROJECTS="clang;compiler-rt" \
    -DLLVM_TARGETS_TO_BUILD="X86;AArch64" \
    -DLLVM_INCLUDE_TESTS=OFF \
    -DLLVM_INCLUDE_EXAMPLES=OFF \
    -DLLVM_INCLUDE_BENCHMARKS=OFF \
    -DLLVM_ENABLE_ASSERTIONS=OFF \
    -DCMAKE_INSTALL_PREFIX=/usr/local \
    ../llvm

# Build LLVM (this takes ~2 hours on single core, ~30 min on 8 cores)
# Using limited parallelism (-j2) to avoid OOM on 8GB RAM systems
RUN ninja -j2 clang

# Install binaries
RUN ninja install-clang install-clang-headers install-clang-libraries

# Runtime stage (copy only what we need)
FROM ubuntu:22.04

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    libstdc++6 \
    libz3-4 \
    libzstd1 \
    libxml2 \
    && rm -rf /var/lib/apt/lists/*

# Copy clang binaries and libraries from builder
COPY --from=builder /usr/local/bin/clang* /usr/local/bin/
COPY --from=builder /usr/local/lib/clang /usr/local/lib/clang
COPY --from=builder /usr/local/lib/libclang* /usr/local/lib/
COPY --from=builder /usr/local/include/clang /usr/local/include/clang

# Set up environment
ENV PATH="/usr/local/bin:${PATH}"
ENV LD_LIBRARY_PATH="/usr/local/lib:${LD_LIBRARY_PATH}"

# Verify installation
RUN clang --version

# Set working directory
WORKDIR /src

# Default command
CMD ["/bin/bash"]
