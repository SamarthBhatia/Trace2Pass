# Dockerfile for evaluating Trace2Pass on buggy LLVM versions
# Usage: docker build --build-arg LLVM_VERSION=16 -f Dockerfile.trace2pass-eval -t trace2pass-eval:16 ../../
#
# The build context should be the project root (../../ from this file)
# so that instrumentor/ and runtime/ source are available.

ARG LLVM_VERSION=16
FROM silkeh/clang:${LLVM_VERSION}

ARG LLVM_VERSION=16

# Install build tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    cmake make git ca-certificates bc curl unzip \
    libpcre3-dev zlib1g-dev \
    python3-pip python3-setuptools \
    autoconf automake libtool \
    xz-utils \
    && rm -rf /var/lib/apt/lists/*

# mbedtls 3.x build dependencies
RUN pip3 install --break-system-packages jinja2 jsonschema 2>/dev/null || \
    pip3 install jinja2 jsonschema

# Copy instrumentor and runtime source
COPY instrumentor/ /trace2pass/instrumentor/
COPY runtime/ /trace2pass/runtime/

# Build instrumentor against this LLVM version
RUN mkdir -p /trace2pass/instrumentor/build && \
    cd /trace2pass/instrumentor/build && \
    cmake -DLLVM_DIR=/usr/lib/llvm-${LLVM_VERSION}/lib/cmake/llvm .. && \
    make -j$(nproc)

# Build runtime
RUN mkdir -p /trace2pass/runtime/build && \
    cd /trace2pass/runtime/build && \
    cmake .. && \
    make -j$(nproc)

# Set environment for convenience
ENV TRACE2PASS_PLUGIN=/trace2pass/instrumentor/build/Trace2PassInstrumentor.so
ENV TRACE2PASS_RUNTIME=/trace2pass/runtime/build/libTrace2PassRuntime.a
ENV LLVM_VERSION=${LLVM_VERSION}

WORKDIR /workspace
