#!/usr/bin/env python3
"""
trace2pass-cc-autoref — instrumenting compiler wrapper with two signals.

(1) Runtime auto-reference ("survive" detection): build an O0-with-plugin
    reference, capture its accumulator checksum, embed as a strong
    __trace2pass_ref_checksum symbol; the runtime compares at fini and
    fires Type: checksum_mismatch if the optimized build diverges.

(2) Build-time prevention-as-detection: also build plain-O0 and
    plain-O<level> binaries (no plugin) plus the instrumented final, hash
    (exit_code, stdout) for all three, and emit Type: prevention_detected
    from the wrapper itself when the uninstrumented optimized build
    diverges from the O0 baseline but instrumentation suppresses the
    divergence.

Fall-soft: any build/run failure disables prevention-detection for this
invocation; the runtime auto-compare still runs. The wrapper never aborts
the user's build with a non-zero return caused by the 3-way check.

Usage:
    trace2pass-cc-autoref [clang-args...] source.{c,cpp} -o binary
"""

import hashlib
import os
import shlex
import subprocess
import sys
import tempfile
import time


PLUGIN_DEFAULT  = "/usr/local/lib/Trace2PassInstrumentor.so"
RUNTIME_DEFAULT = "/usr/local/lib/libTrace2PassRuntime.a"
TIMEOUT_DEFAULT = 10


def log(msg):
    if os.environ.get("TRACE2PASS_AUTOREF_VERBOSE") == "1":
        sys.stderr.write(f"trace2pass-cc-autoref: {msg}\n")


def warn(msg):
    sys.stderr.write(f"trace2pass-cc-autoref: warning: {msg}\n")


def find_clang():
    env_clang = os.environ.get("TRACE2PASS_CLANG")
    if env_clang:
        return env_clang
    self_real = os.path.realpath(__file__)
    for path in os.environ.get("PATH", "").split(os.pathsep):
        cand = os.path.join(path, "clang")
        if os.path.exists(cand) and os.path.realpath(cand) != self_real:
            return cand
    sys.stderr.write("trace2pass-cc-autoref: error: cannot find clang. Set TRACE2PASS_CLANG.\n")
    sys.exit(1)


def parse_args(argv):
    source = None
    output = None
    opt_level = None
    is_cpp = False
    pass_through = []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "-o" and i + 1 < len(argv):
            output = argv[i + 1]; i += 2; continue
        if a.startswith("-O"):
            opt_level = a; pass_through.append(a); i += 1; continue
        if not a.startswith("-") and (a.endswith(".c") or a.endswith(".cc")
                                      or a.endswith(".cpp") or a.endswith(".cxx")
                                      or a.endswith(".C")):
            source = a
            if not a.endswith(".c"):
                is_cpp = True
            i += 1; continue
        pass_through.append(a); i += 1
    return source, output, opt_level or "-O2", is_cpp, pass_through


def compiler_for(clang, is_cpp):
    if is_cpp:
        return clang if clang.endswith("++") else clang + "++"
    return clang


def run_build_with_plugin(clang, source, output, plugin, runtime,
                          pass_through, is_cpp, extra_objs=None):
    compiler = compiler_for(clang, is_cpp)
    cmd = [compiler, *pass_through, source]
    if extra_objs:
        cmd += extra_objs
    cmd += [f"-fpass-plugin={plugin}", runtime, "-lpthread", "-ldl", "-lm",
            "-o", output]
    env = os.environ.copy()
    env["TRACE2PASS_ENABLE_BACKEND_CHECKSUM"] = "1"
    log("run_build_with_plugin: " + " ".join(shlex.quote(c) for c in cmd))
    return subprocess.run(cmd, capture_output=True, text=True, env=env)


def run_build_plain(clang, source, output, opt, pass_through, is_cpp):
    compiler = compiler_for(clang, is_cpp)
    cmd = [compiler, opt, *pass_through, source, "-lm", "-o", output]
    log("run_build_plain: " + " ".join(shlex.quote(c) for c in cmd))
    return subprocess.run(cmd, capture_output=True, text=True)


def capture_reference_checksum(ref_binary, timeout):
    """Run O0-with-plugin reference in record mode; return 64-bit accumulator."""
    with tempfile.NamedTemporaryFile("r", suffix=".hash", delete=False) as tf:
        hash_path = tf.name
    env = os.environ.copy()
    env["TRACE2PASS_CHECKSUM_MODE"] = "record"
    env["TRACE2PASS_CHECKSUM_FILE"] = hash_path
    env.pop("TRACE2PASS_COLLECTOR_URL", None)
    ref_exec = os.path.abspath(ref_binary)
    try:
        subprocess.run([ref_exec], env=env, capture_output=True,
                       text=True, timeout=timeout)
        if not os.path.exists(hash_path) or os.path.getsize(hash_path) == 0:
            return None
        with open(hash_path) as f:
            line = f.read().strip()
        if line.startswith("0x") or line.startswith("0X"):
            return int(line, 16)
        return int(line, 16) if all(c in "0123456789abcdefABCDEF" for c in line) else None
    except Exception:
        return None
    finally:
        try: os.unlink(hash_path)
        except OSError: pass


def hash_observable(exit_code, stdout_bytes):
    """MD5 over 'EXIT=<code>\\n' + stdout. First 16 hex chars — not crypto,
    just an equality test that matches the bash wrapper's scheme."""
    h = hashlib.md5()
    h.update(f"EXIT={exit_code}\n".encode("utf-8"))
    h.update(stdout_bytes)
    return h.hexdigest()[:16]


def run_and_hash(binary, timeout):
    """Returns (hash_hex, exit_code) on success; None on any failure."""
    exec_path = os.path.abspath(binary)
    if not os.access(exec_path, os.X_OK):
        return None
    try:
        p = subprocess.run([exec_path], capture_output=True, timeout=timeout)
    except subprocess.TimeoutExpired:
        return None
    except Exception:
        return None
    # Treat coreutils-timeout-like scenarios as failure so we don't
    # classify a truncated observable.
    return hash_observable(p.returncode, p.stdout), p.returncode


def iso_timestamp():
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())


def emit_report(kind, opt_level, baseline_hash, unstr_hash, inst_hash):
    ts = iso_timestamp()
    if kind == "prevention_detected":
        note = (
            "Note: The uninstrumented optimized build diverges from the O0 baseline;\n"
            "      the Trace2Pass-instrumented build matches the baseline. The optimization\n"
            "      bug was suppressed by instrumentation — production safety signal."
        )
    else:
        note = (
            "Note: The instrumented optimized build diverges from the O0 baseline.\n"
            "      The bug survived instrumentation and is visible in the observable\n"
            "      (return code / stdout)."
        )
    out = sys.stderr
    out.write("\n=== Trace2Pass Report ===\n")
    out.write(f"Timestamp: {ts}\n")
    out.write(f"Type: {kind}\n")
    out.write(f"Baseline (O0 plain):     0x{baseline_hash}\n")
    out.write(f"Unstrumented ({opt_level} plain): 0x{unstr_hash}\n")
    out.write(f"Instrumented ({opt_level} plugin): 0x{inst_hash}\n")
    out.write(note + "\n")
    out.write("========================\n\n")
    out.write('{"type":"%s","check_type":"%s","timestamp":"%s",'
              '"baseline":"0x%s","unstrumented":"0x%s","instrumented":"0x%s"}\n' %
              (kind, kind, ts, baseline_hash, unstr_hash, inst_hash))


def main(argv):
    source, output, opt_level, is_cpp, pass_through = parse_args(argv)
    clang   = find_clang()
    plugin  = os.environ.get("TRACE2PASS_PLUGIN", PLUGIN_DEFAULT)
    runtime = os.environ.get("TRACE2PASS_RUNTIME", RUNTIME_DEFAULT)
    timeout = int(os.environ.get("TRACE2PASS_AUTOREF_TIMEOUT", TIMEOUT_DEFAULT))
    disable_pd = os.environ.get("TRACE2PASS_DISABLE_PREVENTION_DETECTION") == "1"

    if not source:
        warn("no source file in args — falling back to bare clang")
        return subprocess.run([clang, *argv]).returncode
    if not output:
        output = "a.out"
    for f in (plugin, runtime):
        if not os.path.exists(f):
            warn(f"missing {f} — falling back to bare clang")
            return subprocess.run([clang, *argv]).returncode

    # ---- 1. O0-with-plugin reference for runtime auto-compare -----------
    ref_passthrough = [a for a in pass_through if not a.startswith("-O")]
    ref_passthrough += ["-O0", "-Xclang", "-disable-O0-optnone"]
    ref_binary = output + ".t2p_ref"
    log(f"building O0-with-plugin reference → {ref_binary}")
    ref_build = run_build_with_plugin(clang, source, ref_binary, plugin, runtime,
                                      ref_passthrough, is_cpp)
    ref_hash_int = None
    if ref_build.returncode == 0:
        ref_hash_int = capture_reference_checksum(ref_binary, timeout)

    stub_obj = None
    if ref_hash_int is not None and ref_hash_int != 0:
        log(f"captured accumulator reference 0x{ref_hash_int:016x}")
        with tempfile.NamedTemporaryFile("w", suffix=".c", delete=False) as sf:
            sf.write("/* generated by trace2pass-cc-autoref */\n"
                     "#include <stdint.h>\n"
                     f"const uint64_t __trace2pass_ref_checksum = 0x{ref_hash_int:016x}ULL;\n")
            stub_src = sf.name
        stub_obj = stub_src[:-2] + ".o"
        comp = subprocess.run([clang, "-c", stub_src, "-o", stub_obj],
                              capture_output=True, text=True)
        if comp.returncode != 0:
            warn(f"stub compile failed — runtime auto-compare disabled\n{comp.stderr}")
            stub_obj = None
        try: os.unlink(stub_src)
        except OSError: pass

    # ---- 2. Final instrumented build at caller's -O level ---------------
    extra = [stub_obj] if stub_obj else None
    final_build = run_build_with_plugin(clang, source, output, plugin, runtime,
                                        pass_through, is_cpp, extra_objs=extra)
    if final_build.stdout: sys.stdout.write(final_build.stdout)
    if final_build.stderr: sys.stderr.write(final_build.stderr)

    # Always clean up intermediate artefacts even when we fail.
    def _cleanup():
        for p in (ref_binary, stub_obj,
                  output + ".t2p_plain_o0",
                  output + ".t2p_plain_ox"):
            if p and os.path.exists(p):
                try: os.unlink(p)
                except OSError: pass

    if final_build.returncode != 0:
        _cleanup()
        return final_build.returncode

    # ---- 3. Prevention-as-detection (3-way observable) -----------------
    if disable_pd:
        _cleanup()
        return 0

    plain_o0 = output + ".t2p_plain_o0"
    plain_ox = output + ".t2p_plain_ox"

    log(f"building plain-O0 observable → {plain_o0}")
    p0_build = run_build_plain(clang, source, plain_o0, "-O0",
                               ref_passthrough, is_cpp)
    if p0_build.returncode != 0:
        warn("plain-O0 build failed — prevention-detection disabled")
        _cleanup(); return 0

    log(f"building plain-{opt_level} observable → {plain_ox}")
    plain_ox_args = [a for a in pass_through if not a.startswith("-O")]
    pox_build = run_build_plain(clang, source, plain_ox, opt_level,
                                plain_ox_args, is_cpp)
    if pox_build.returncode != 0:
        warn(f"plain-{opt_level} build failed — prevention-detection disabled")
        _cleanup(); return 0

    baseline = run_and_hash(plain_o0, timeout)
    if baseline is None:
        warn("plain-O0 run failed/timed out — prevention-detection disabled")
        _cleanup(); return 0
    unstr = run_and_hash(plain_ox, timeout)
    if unstr is None:
        warn(f"plain-{opt_level} run failed/timed out — prevention-detection disabled")
        _cleanup(); return 0
    inst = run_and_hash(output, timeout)
    if inst is None:
        warn("instrumented run failed/timed out — prevention-detection disabled")
        _cleanup(); return 0

    bh, uh, ih = baseline[0], unstr[0], inst[0]
    log(f"observable hashes: O0={bh} Ox={uh} inst={ih}")

    if ih != bh:
        emit_report("checksum_mismatch", opt_level, bh, uh, ih)
        sys.stderr.write(f"trace2pass-cc-autoref: checksum_mismatch (O0={bh} Ox={uh} inst={ih})\n")
    elif uh != bh:
        emit_report("prevention_detected", opt_level, bh, uh, ih)
        sys.stderr.write(f"trace2pass-cc-autoref: prevention_detected (O0={bh} Ox={uh} inst={ih})\n")
    else:
        log("observable hashes all match — no bug")

    _cleanup()
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
